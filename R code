# ---------------------------------------------------------------------
# 23. Score test with two-way clustering (cohort and year)
#     V = V_cohort + V_year - V_cell (Cameron, Gelbach and Miller), with
#     negative eigenvalues set to zero. The variance is computed from the
#     residuals of the model with digit effects: with year clusters, the
#     residuals of the restricted model would contain the digit pattern of
#     every year and the test would lose its power. With few years this
#     test over-rejects in the simulation (section 27), so it is reported
#     only as a check and not used for inference.
# ---------------------------------------------------------------------
score_twoway <- function(y, dz) {
  na <- c(score_2way = NA, p_2way = NA)
  f0 <- pois_fit(y, dz$X0); f1 <- pois_fit(y, dz$X1)       # models without and with digit effects
  if (is.null(f0) || is.null(f1)) return(na)
  mu0 <- f0$fitted.values; X0 <- dz$X0                     # fitted counts and design under H0
  A <- solve(crossprod(X0, X0 * mu0), crossprod(X0, dz$D * mu0))  # projection on nuisance terms
  Dt <- dz$D - X0 %*% A                                    # digit columns purged of nuisance terms
  S <- colSums(Dt * (y - mu0))                             # score (9 digit contrasts) under H0
  U <- Dt * (y - f1$fitted.values)                         # cell contributions for the variance
  Vc <- crossprod(rowsum(U, dz$grid$cohort))               # cohort clusters
  Vy <- crossprod(rowsum(U, dz$grid$year))                 # year clusters
  V0 <- crossprod(U)                                       # cell level (intersection of the two)
  ev <- eigen(Vc + Vy - V0, symmetric = TRUE)              # two-way variance
  V2 <- ev$vectors %*% diag(pmax(ev$values, 0)) %*% t(ev$vectors)  # make it positive semi-definite
  Vi <- tryCatch(solve(V2), error = function(e) ginv(V2))  # Route A: solve, Route B: ginv
  T2 <- as.numeric(t(S) %*% Vi %*% S)
  c(score_2way = T2, p_2way = pchisq(T2, 9, lower.tail = FALSE))
}

# ---------------------------------------------------------------------
# 24. Comparison on the same age range (ages 23-72): a model without
#     cohort effects (smooth age + year + digit), on the same index scale
# ---------------------------------------------------------------------
nocohort_index <- function(y, dz) {
  X <- model.matrix(~ ns(age, 8) + factor(year) + digit, dz$grid)  # no cohort effects
  f <- pois_fit(y, X)
  if (is.null(f)) return(NA)
  b <- f$coefficients[paste0("digit", 1:9)]                # digit effects relative to digit 0
  if (any(is.na(b))) return(NA)
  digit_index(c(0, b) - mean(c(0, b)))                     # index on the Myers scale
}

