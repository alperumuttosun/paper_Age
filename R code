# ---------------------------------------------------------------------
# 25. Numerical check of Condition 2 for the spline bases used (Table S2)
#     (k = 1 for every unit). The condition holds when the space of first
#     differences of the age function and the space of 10-periodic
#     sequences share only the constants. The largest canonical
#     correlation between the two spaces (constants removed) measures how
#     close the design is to weak identification (1 = not identified).
# ---------------------------------------------------------------------
cond2_file <- file.path(out_dir, "step08_condition2_check.csv")
if (!file.exists(cond2_file)) {
  ranges <- list(`23-72` = 23:72, `20-79` = 20:79, `25-69` = 25:69, `30-79` = 30:79, `10-89` = 10:89)
  rows <- list()
  for (rn in names(ranges)) for (df in c(6, 8, 12)) {
    a <- ranges[[rn]]
    Bs <- cbind(a, ns(a, df = df))                         # linear term plus natural spline basis
    dB <- Bs[-1, , drop = FALSE] - Bs[-nrow(Bs), , drop = FALSE]  # first differences f(a+1) - f(a)
    P <- outer(a[-length(a)] %% 10, 0:9, "==") * 1         # 10-periodic sequences on A_1
    cen <- function(M) scale(M, scale = FALSE)             # remove the constant component
    r_dB <- qr(dB)$rank; r_P <- qr(P)$rank
    dim_common <- r_dB + r_P - qr(cbind(dB, P))$rank       # dimension of the intersection
    Q1 <- qr.Q(qr(cen(dB)))[, seq_len(qr(cen(dB))$rank), drop = FALSE]  # orthonormal basis, no constants
    Q2 <- qr.Q(qr(cen(P)))[, seq_len(qr(cen(P))$rank), drop = FALSE]
    rows[[length(rows) + 1]] <- data.frame(age_range = rn, df = df,
      dim_intersection = dim_common,                       # 1 = only constants: Condition 2 holds
      condition2_holds = dim_common == 1,
      max_canonical_correlation = max(svd(t(Q1) %*% Q2)$d))  # below 1 = identified; near 1 = weak
  }
  cond2 <- do.call(rbind, rows)
  write.csv(cond2, cond2_file, row.names = FALSE)
} else cond2 <- read.csv(cond2_file)
print(cond2, row.names = FALSE)

