# 4. Helper objects and functions for the cohort-adjusted index
# ---------------------------------------------------------------------
A_digit <- outer(myers_ages %% 10, 0:9, "==") * 1          # 80 x 10 matrix: age -> its terminal digit
W_digit <- W_myers %*% A_digit                             # blending applied to digit multipliers

# Myers index of a flat reference population distorted only by digit factors
digit_index <- function(dc) {                              # dc: 10 centred log digit effects
  f <- exp(as.matrix(dc))                                  # multiplicative digit factors (10 x k)
  b <- W_digit %*% f                                       # blended totals per digit
  sh <- 100 * sweep(b, 2, colSums(b), "/")                 # blended shares in percent
  0.5 * colSums(abs(sh - 10))                              # one index value per column
}

# Fit the Lexis model for one region: log N(a,t) = smooth age + year + cohort + digit
fit_digit_model <- function(s, df_age = 8) {
  s$cohort <- s$year - s$age                               # birth year of each cell
  s$digit  <- factor(s$age %% 10, levels = 0:9)            # terminal digit of age
  fit <- tryCatch(                                         # Route A: least squares on log counts
    lm(log(value + 0.5) ~ ns(age, df = df_age) + factor(year) + factor(cohort) + digit, data = s),
    error = function(e) NULL)
  if (is.null(fit))                                        # Route B: quasi-Poisson model on counts
    fit <- tryCatch(glm(round(value) ~ ns(age, df = df_age) + factor(year) + factor(cohort) + digit,
                        family = quasipoisson(), data = s), error = function(e) NULL)
  if (is.null(fit)) return(NULL)
  b <- coef(fit)[paste0("digit", 1:9)]                     # digit effects relative to digit 0
  if (any(is.na(b))) return(list(identified = FALSE))      # digit effects not identifiable
  keep <- !is.na(coef(fit))                                # drop aliased columns
  X <- model.matrix(fit)[, keep, drop = FALSE]             # design matrix
  e <- residuals(fit, type = "working")                    # residuals
  bread <- solve(crossprod(X))                             # (X'X)^-1
  meat  <- crossprod(rowsum(X * e, s$cohort))              # cohort-clustered score products
  G <- length(unique(s$cohort))                            # number of cohort clusters
  V <- (bread %*% meat %*% bread) * G / (G - 1)            # cluster-robust covariance
  idx <- match(paste0("digit", 1:9), colnames(X))          # positions of digit effects
  Vb <- V[idx, idx]                                        # covariance of digit effects
  C <- rbind(0, diag(9)) - 1 / 10                          # map 9 contrasts to 10 centred effects
  dc <- as.vector(C %*% b)                                 # centred digit effects
  Vc <- C %*% Vb %*% t(C)                                  # their covariance
  list(identified = TRUE, b = b, Vb = Vb, dc = dc, Vc = Vc)
}

# Index, noise floor, interval and test from a fitted model
summarise_digit <- function(m, B = 1000) {
  est <- digit_index(m$dc)                                 # estimated cohort-adjusted index
  L <- tryCatch(t(chol(m$Vc + diag(1e-12, 10))), error = function(e) NULL)  # Cholesky factor
  if (is.null(L)) {                                        # Route B: eigen square root
    ev <- eigen(m$Vc, symmetric = TRUE)
    L <- ev$vectors %*% diag(sqrt(pmax(ev$values, 0)))
  }
  Z <- matrix(rnorm(10 * B), 10, B)                        # standard normal draws
  floor0 <- mean(digit_index(L %*% Z))                     # index expected from noise alone
  draws  <- digit_index(m$dc + L %*% Z)                    # index around the estimate
  wald <- as.numeric(t(m$b) %*% solve(m$Vb, m$b))          # Wald statistic, H0: no digit preference
  bias <- mean(draws) - est                                # simulation estimate of the upward bias
  q <- unname(quantile(draws, c(0.025, 0.975)))            # percentiles of the draws
  c(index = est, noise_floor = floor0,
    index_corrected = max(0, est - bias),                  # bias-corrected index
    ci_low = max(0, 2 * est - q[2]),                       # basic simulation interval, lower
    ci_high = max(0, 2 * est - q[1]),                      # basic simulation interval, upper
    wald = wald, p_wald = pchisq(wald, df = 9, lower.tail = FALSE),
    excess_digit0_pct = 100 * (exp(m$dc[1]) - 1),          # % excess at ages ending in 0
    excess_digit5_pct = 100 * (exp(m$dc[6]) - 1))          # % excess at ages ending in 5
}

# Heaping generator with fractional shares (for simulation on expected counts)
heap_counts <- function(x, h) {
  new <- x
  for (i in seq_along(myers_ages)) {
    a <- myers_ages[i]; if (a %% 5 == 0) next              # ages ending in 0/5 stay
    t <- round(a / 5) * 5; if (t > 89) t <- 85             # nearest multiple of 5 inside 10-89
    k <- h * x[i]                                          # share h moves to the heaped age
    new[i] <- new[i] - k; new[t - 9] <- new[t - 9] + k
  }
  new
}

