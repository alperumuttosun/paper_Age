    m0 <- fit_digit_pois(s0[s0$age %in% main_ages, ])
    s0$value <- s0$value * exp(-m0$dc[s0$age %% 10 + 1])
    base8[[key]] <- list(s0 = s0, yrs = yrs, dz = build_design(main_ages, yrs))
  }
  s0 <- base8[[key]]$s0; yrs <- base8[[key]]$yrs; dz <- base8[[key]]$dz
  pat <- if (st$scenario %in% c("zero_only", "zero_gt_five", "two_eight")) st$scenario else "zero_five"
  hm <- heap_map(pat)
  h_year <- if (st$scenario == "time_varying")             # heaping share in each year
    st$heaping * seq(0.5, 1.5, length.out = length(yrs)) else rep(st$heaping, length(yrs))
  lam <- mapply(function(v, h) heap_pattern(v, h, hm), split(s0$value, s0$year), h_year,
                SIMPLIFY = FALSE)                          # expected heaped counts per year
  in_main <- myers_ages %in% main_ages
  y_pop <- unlist(lapply(lam, function(v) v[in_main]))
  target <- if (st$heaping == 0) 0 else {                  # estimand: fit to expected heaped counts
    f <- pois_fit(y_pop, dz$X1); b <- f$coefficients[dz$di1]; digit_index(c(0, b) - mean(c(0, b)))
  }
  res <- matrix(NA, st$R, 7)
  for (r in seq_len(st$R)) {
    eps <- matrix(0, length(myers_ages), length(yrs))      # log-scale perturbation (age x year)
    if (st$scenario == "year_shock") for (j in seq_along(yrs)) {
      ctr <- runif(1, 20, 65)                              # centre of this year's bump
      eps[, j] <- 0.03 * rnorm(1) * exp(-(myers_ages - ctr)^2 / (2 * 4^2))
    }
    if (st$scenario == "cohort_ar") {
      coh <- outer(myers_ages, yrs, function(a, t) t - a)  # cohort of each cell
      cs <- sort(unique(as.vector(coh)))
      e <- matrix(0, length(cs), length(yrs))              # AR(1) path for each cohort
      e[, 1] <- rnorm(length(cs), 0, 0.02 / sqrt(1 - 0.7^2))
      for (j in seq_along(yrs)[-1]) e[, j] <- 0.7 * e[, j - 1] + rnorm(length(cs), 0, 0.02)
      for (j in seq_along(yrs)) eps[, j] <- e[match(coh[, j], cs), j]
    }
    smp <- lapply(seq_along(lam), function(j)              # n persons aged 10-89 per year
      as.vector(rmultinom(1, st$n, lam[[j]] * exp(eps[, j]))))
    raw <- mean(sapply(smp, myers_index))                  # classical Myers
    y <- unlist(lapply(smp, function(v) v[in_main]))       # ages 23-72 for the models
    a1 <- infer_digit(y, dz, B_draw = 300, B_wild = 199)
    if (is.null(a1)) next
    a2 <- score_twoway(y, dz)
    res[r, ] <- c(raw, a1[["index_corrected"]], a1[["ci_low_tb"]], a1[["ci_high"]],
                  a1[["p_score"]], a1[["p_wild"]], a2[["p_2way"]])
  }
  ok <- !is.na(res[, 2])
  row <- data.frame(id = st$id, scenario = st$scenario, base = st$base, n_years = st$n_years, n = st$n,
    heaping = st$heaping, R = sum(ok), target = target,
    classical_mean = mean(res[ok, 1]), adjusted_mean = mean(res[ok, 2]),
    bias = mean(res[ok, 2]) - target, rmse = sqrt(mean((res[ok, 2] - target)^2)),
    coverage_testbased = mean(res[ok, 3] <= target & target <= res[ok, 4]),
    reject_score = mean(res[ok, 5] < 0.05), reject_wild = mean(res[ok, 6] < 0.05),
    reject_2way = mean(res[ok, 7] < 0.05, na.rm = TRUE))
  write.table(row, sim8_prog, sep = ",", row.names = FALSE,
              col.names = !file.exists(sim8_prog), append = file.exists(sim8_prog))
  cat(format(Sys.time(), "%H:%M"), "step 08 setting", st$id, "of", nrow(sim8_settings),
      "done (", st$scenario, st$base, st$n_years, "years, h =", st$heaping, ")\n")
}

