sim6_settings <- expand.grid(heaping = c(0, 0.01, 0.02, 0.05), n = c(2e4, 1e5, 1e6),
                             n_years = c(8, 18), base = c("DE", "RO", "PL", "EL", "TR"),
                             stringsAsFactors = FALSE)
sim6_settings$R <- ifelse(sim6_settings$heaping <= 0.01, 1000, 300)  # more replications where size/coverage matter
sim6_settings$id <- seq_len(nrow(sim6_settings))
done_ids <- if (file.exists(sim6_prog)) read.csv(sim6_prog)$id else integer(0)
todo <- sim6_settings[!sim6_settings$id %in% done_ids, ]
cat("Simulation settings remaining:", nrow(todo), "of", nrow(sim6_settings), "\n")

base_cache <- list()
for (k in seq_len(nrow(todo))) {
  st <- todo[k, ]
  set.seed(2026 + st$id)                                   # reproducible, also after a restart
  key <- paste(st$base, st$n_years)
  if (is.null(base_cache[[key]])) {                        # cohort structure without digit preference
    s_all <- eu2[eu2$geo == st$base & eu2$year >= 2008, ]
    yrs <- tail(sort(unique(s_all$year)), st$n_years)
    s0 <- s_all[s_all$year %in% yrs, ]; s0 <- s0[order(s0$year, s0$age), ]
    m0 <- fit_digit_pois(s0[s0$age %in% main_ages, ])
    s0$value <- s0$value * exp(-m0$dc[s0$age %% 10 + 1])
    base_cache[[key]] <- list(s0 = s0, dz = build_design(main_ages, yrs))
  }
  s0 <- base_cache[[key]]$s0; dz <- base_cache[[key]]$dz
  lam <- lapply(split(s0$value, s0$year), heap_counts, h = st$heaping)  # expected heaped counts per year
  in_main <- myers_ages %in% main_ages
  # estimand: index of the model fitted to the expected heaped counts (exactly 0 without heaping)
  y_pop <- unlist(lapply(lam, function(v) v[in_main]))
  target <- if (st$heaping == 0) 0 else {
    f <- pois_fit(y_pop, dz$X1); digit_index(c(0, f$coefficients[dz$di1]) - mean(c(0, f$coefficients[dz$di1])))
  }
  res <- matrix(NA, st$R, 9)
  for (r in seq_len(st$R)) {
    smp <- lapply(lam, function(v) as.vector(rmultinom(1, st$n, v)))  # n persons aged 10-89 per year
    raw <- mean(sapply(smp, myers_index))                  # classical Myers
    y <- unlist(lapply(smp, function(v) v[in_main]))       # ages 23-72 for the models
    a <- infer_digit(y, dz, B_draw = 300, B_wild = 199)
    if (is.null(a)) next
    res[r, ] <- c(raw, a[["index_corrected"]], a[["ci_low"]], a[["ci_high"]], a[["ci_low_tb"]],
                  a[["p_score"]], a[["p_wild"]], 1 - pchisq(a[["wald"]], 9), smooth_index(y, dz))
  }
  ok <- !is.na(res[, 2])
  row <- data.frame(id = st$id, base = st$base, n_years = st$n_years, n = st$n, heaping = st$heaping,
    R = sum(ok), target = target,
    classical_mean = mean(res[ok, 1]), smooth_mean = mean(res[ok, 9], na.rm = TRUE),
    adjusted_mean = mean(res[ok, 2]), bias = mean(res[ok, 2]) - target,
    rmse = sqrt(mean((res[ok, 2] - target)^2)),
    smooth_bias = mean(res[ok, 9], na.rm = TRUE) - target,
    coverage_basic = mean(res[ok, 3] <= target & target <= res[ok, 4]),
    coverage_testbased = mean(res[ok, 5] <= target & target <= res[ok, 4]),
    reject_score = mean(res[ok, 6] < 0.05), reject_wild = mean(res[ok, 7] < 0.05),
    reject_wald = mean(res[ok, 8] < 0.05),
    q95_adjusted = unname(quantile(res[ok, 2], 0.95)))    # noise threshold when heaping = 0
  write.table(row, sim6_prog, sep = ",", row.names = FALSE,
              col.names = !file.exists(sim6_prog), append = file.exists(sim6_prog))
  cat(format(Sys.time(), "%H:%M"), "setting", st$id, "of", nrow(sim6_settings),
      "done (", st$base, st$n_years, "years, n =", st$n, ", h =", st$heaping, ")\n")
}

