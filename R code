    dz <- build_design(main_ages, unique(s$year), df_best)
    r <- infer_digit(s$value, dz, B_draw = 300, B_wild = 99)  # index with the chosen flexibility
    out[[g]] <- data.frame(geo = g, df_qaic = df_best, index_corrected_qaic = r[["index_corrected"]])
    if (k %% 50 == 0) cat("QAIC selection:", k, "of", nrow(fin), "\n")
