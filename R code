myers_ages <- 10:89                                        # Myers uses ages 10-89 (starts 10 and 20)

# Blending weight matrix: rows = terminal digits 0-9, columns = ages 10-89
make_W <- function() {
  W <- matrix(0, nrow = 10, ncol = length(myers_ages))     # empty 10 x 80 matrix
  for (d in 0:9) {                                         # loop over terminal digits
    a1 <- seq(10 + d, 79, by = 10)                         # ages ending in d, starting at 10 (up to 79)
    a2 <- seq(20 + d, 89, by = 10)                         # ages ending in d, starting at 20 (up to 89)
    W[d + 1, a1 - 9] <- W[d + 1, a1 - 9] + (d + 1)         # weight (d+1) for the first series
    W[d + 1, a2 - 9] <- W[d + 1, a2 - 9] + (9 - d)         # weight (9-d) for the second series
  }
  W                                                        # return the matrix
}
W_myers <- make_W()                                        # build it once

# Myers' blended index from counts at ages 10-89
myers_index <- function(counts) {
  b <- as.vector(W_myers %*% counts)                       # blended totals per terminal digit
  share <- 100 * b / sum(b)                                # blended shares in percent
  0.5 * sum(abs(share - 10))                               # Myers index = half sum of |share - 10|
}

