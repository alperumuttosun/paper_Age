read_eurostat_tsv <- function(path) {                      # parse Eurostat bulk TSV file
  x <- read.delim(path, check.names = FALSE, stringsAsFactors = FALSE,
                  na.strings = ":", colClasses = "character")  # read everything as text
  key <- do.call(rbind, strsplit(x[[1]], ","))             # first column holds freq,unit,sex,age,geo
  hdr <- strsplit(sub("\\\\.*$", "", names(x)[1]), ",")[[1]]  # names of those key fields
  colnames(key) <- hdr
  keep <- key[, "sex"] == "T"                              # both sexes only
  key <- key[keep, , drop = FALSE]; x <- x[keep, -1, drop = FALSE]
  yrs <- as.integer(trimws(names(x)))                      # year columns
  out <- data.frame(geo = rep(key[, "geo"], times = length(yrs)),
                    age = rep(key[, "age"], times = length(yrs)),
                    year = rep(yrs, each = nrow(key)),
                    value = as.numeric(gsub("[^0-9.]", "", unlist(x))),  # drop flags like "p", "e"
                    stringsAsFactors = FALSE)
  out[!is.na(out$value), ]                                 # drop missing cells
}

