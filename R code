# ---------------------------------------------------------------------
# 9. Poisson log-linear estimator (replaces least squares on log counts)
#     With year effects in the model, the Poisson fit is equivalent to a
#     multinomial model for the age distribution of each year.
# ---------------------------------------------------------------------
fit_digit_pois <- function(s, df_age = 8) {
  s$cohort <- s$year - s$age                               # birth year of each cell
  s$digit  <- factor(s$age %% 10, levels = 0:9)            # terminal digit of age
  form <- value ~ ns(age, df = df_age) + factor(year) + factor(cohort) + digit
  fit <- tryCatch(                                         # Route A: quasi-Poisson GLM
    suppressWarnings(glm(form, family = quasipoisson(), data = s,
                         control = glm.control(maxit = 100))),
    error = function(e) NULL)
  if (is.null(fit) || !fit$converged)                      # Route B: Poisson GLM started from log counts
    fit <- tryCatch(suppressWarnings(glm(form, family = poisson(), data = s,
                         mustart = pmax(s$value, 1), control = glm.control(maxit = 200))),
                    error = function(e) NULL)
  if (is.null(fit)) return(NULL)
  b <- coef(fit)[paste0("digit", 1:9)]                     # digit effects relative to digit 0
  if (any(is.na(b))) return(list(identified = FALSE))      # digit effects not identifiable
  keep <- !is.na(coef(fit))                                # drop aliased columns
  X  <- model.matrix(fit)[, keep, drop = FALSE]            # design matrix
  mu <- fitted(fit)                                        # fitted counts
  r  <- s$value - mu                                       # response residuals
  bread <- solve(crossprod(X, X * mu))                     # (X' W X)^-1 for the log link
  meat  <- crossprod(rowsum(X * r, s$cohort))              # cohort-clustered score products
  G <- length(unique(s$cohort))                            # number of cohort clusters
  V <- (bread %*% meat %*% bread) * G / (G - 1)            # cluster-robust covariance
  idx <- match(paste0("digit", 1:9), colnames(X))
  Vb <- V[idx, idx]
  C <- rbind(0, diag(9)) - 1 / 10                          # 9 contrasts -> 10 centred effects
  list(identified = TRUE, b = b, Vb = Vb, dc = as.vector(C %*% b), Vc = C %*% Vb %*% t(C),
       fit = fit)
}

# Number of identified digit contrasts for the actual ages and years of a unit
rank_digits <- function(s, df_age = 8) {
  g <- unique(s[, c("age", "year")]); g$cohort <- g$year - g$age
  X0 <- model.matrix(~ ns(age, df_age) + factor(year) + factor(cohort), g)
  D  <- model.matrix(~ factor(age %% 10), g)[, -1]
  qr(cbind(X0, D))$rank - qr(X0)$rank                      # 9 = all contrasts identified
}

fit_unit_pois <- function(g, ages = main_ages, df = 8, years = NULL, B = 1000) {
  s <- eu2[eu2$geo == g & eu2$age %in% ages, ]
  if (!is.null(years)) s <- s[s$year %in% years, ]         # optional subset of years
  m <- fit_digit_pois(s, df_age = df)
  if (is.null(m) || !m$identified) return(NULL)
  r <- summarise_digit(m, B = B)
  data.frame(geo = g, t(r))
}

