# ---------------------------------------------------------------------
# 15. Fast fitting on a fixed design (the design is the same in every
#     replication of a setting, so it is built only once)
# ---------------------------------------------------------------------
build_design <- function(ages, years, df_age = 8) {
  g <- expand.grid(age = ages, year = sort(years))         # cells ordered by year, then age
  g$cohort <- g$year - g$age
  g$digit <- factor(g$age %% 10, levels = 0:9)
  drop_aliased <- function(X) { q <- qr(X); X[, sort(q$pivot[seq_len(q$rank)]), drop = FALSE] }
  X1 <- drop_aliased(model.matrix(~ ns(age, df_age) + factor(year) + factor(cohort) + digit, g))
  X0 <- drop_aliased(model.matrix(~ ns(age, df_age) + factor(year) + factor(cohort), g))
  dfy <- max(1, min(4, length(unique(g$year)) - 1))        # smooth year basis for the comparison model
  XS <- drop_aliased(model.matrix(~ ns(age, df_age) * ns(year, dfy) + digit, g))  # smooth surface, no cohorts
  D <- model.matrix(~ digit, g)[, -1]                      # nine digit contrasts
  list(grid = g, X1 = X1, X0 = X0, XS = XS, D = D,
       di1 = match(paste0("digit", 1:9), colnames(X1)), diS = match(paste0("digit", 1:9), colnames(XS)))
}

pois_fit <- function(y, X) {
  f <- tryCatch(suppressWarnings(glm.fit(X, y, family = poisson(),  # Route A: default start
                control = glm.control(maxit = 100))), error = function(e) NULL)
  if (is.null(f) || !f$converged)                          # Route B: start from log counts
    f <- tryCatch(suppressWarnings(glm.fit(X, y, family = poisson(), mustart = pmax(y, 1),
                  control = glm.control(maxit = 300))), error = function(e) NULL)
  f
}

# Full inference for one data vector y on design dz
infer_digit <- function(y, dz, B_draw = 500, B_wild = 399) {
  cl <- dz$grid$cohort
  f1 <- pois_fit(y, dz$X1); f0 <- pois_fit(y, dz$X0)
  if (is.null(f1) || is.null(f0)) return(NULL)
  b <- f1$coefficients[dz$di1]
  if (any(is.na(b))) return(NULL)
  # (a) cluster-robust covariance of the digit effects at the unrestricted fit
  mu <- f1$fitted.values; r <- y - mu; X <- dz$X1
  bread <- chol2inv(chol(crossprod(X, X * mu)))
  G <- length(unique(cl))
  V <- bread %*% crossprod(rowsum(X * r, cl)) %*% bread * G / (G - 1)
  Vb <- V[dz$di1, dz$di1]
  C <- rbind(0, diag(9)) - 1 / 10
  m <- list(b = b, Vb = Vb, dc = as.vector(C %*% b), Vc = C %*% Vb %*% t(C))
  est <- summarise_digit(m, B = B_draw)                    # index, bias correction, basic interval
  # (b) score test of no digit preference at the restricted fit, cohort clusters
  mu0 <- f0$fitted.values; r0 <- y - mu0; X0 <- dz$X0
  A <- solve(crossprod(X0, X0 * mu0), crossprod(X0, dz$D * mu0))
  Dt <- dz$D - X0 %*% A                                    # digit columns purged of nuisance terms
  Sc <- rowsum(Dt * r0, cl)                                # cluster scores
  S <- colSums(Sc); Vs <- crossprod(Sc)
  Vi <- tryCatch(solve(Vs), error = function(e) MASS::ginv(Vs))
  T0 <- as.numeric(t(S) %*% Vi %*% S)
  p_score <- pchisq(T0, 9, lower.tail = FALSE)
  # (c) wild cluster bootstrap of the score statistic (Rademacher weights)
  Wb <- matrix(sample(c(-1, 1), nrow(Sc) * B_wild, TRUE), nrow(Sc))
  Sb <- crossprod(Sc, Wb)
  p_wild <- (1 + sum(colSums(Sb * (Vi %*% Sb)) >= T0)) / (B_wild + 1)
  # (d) test-based interval: lower limit is zero when no digit preference cannot be rejected
  ci_low_tb <- if (p_score >= 0.05) 0 else est[["ci_low"]]
  c(est, score = T0, p_score = p_score, p_wild = p_wild, ci_low_tb = ci_low_tb)
}

smooth_index <- function(y, dz) {                          # comparison: smooth latent surface, no cohorts
  f <- pois_fit(y, dz$XS)
  if (is.null(f)) return(NA)
  b <- f$coefficients[dz$diS]
  if (any(is.na(b))) return(NA)
  digit_index(c(0, b) - mean(c(0, b)))
}

