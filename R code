# STEP 09  (decomposition of the difference between the classical and the
#           cohort-adjusted index on the same age range, and weak
#           identification as a function of the spline flexibility)
# =====================================================================

# ---------------------------------------------------------------------
# 28. Cross-sectional counterpart on ages 23-72: for every unit and year a
#     model with a smooth age function and digit effects is fitted to that
#     single year; the index is averaged over years, as the classical index.
#     Together with the pooled model without cohort effects (step08), the
#     smooth-surface model and the cohort-adjusted model, this separates
#     the effect of the age range from that of using repeated distributions
#     (Table 4).
# ---------------------------------------------------------------------
cs_digit_index <- function(v, ages = main_ages, df_age = 8) {  # one year, one unit
  d <- data.frame(value = v, age = ages, digit = factor(ages %% 10, levels = 0:9))
  X <- model.matrix(~ ns(age, df_age) + digit, d)          # smooth age curve + digit effects
  f <- pois_fit(d$value, X)                                # Route A / Route B inside pois_fit
  if (is.null(f)) return(NA)
  b <- f$coefficients[paste0("digit", 1:9)]
  if (any(is.na(b))) return(NA)
  digit_index(c(0, b) - mean(c(0, b)))                     # index on the Myers scale
}

cs9_file <- file.path(out_dir, "step09_cross_section_23_72.csv")
