# ---------------------------------------------------------------------
# 27. Simulation with dependence and with other digit patterns
#     (long: about 1-2 hours; progress is saved after every setting and
#      the simulation resumes where it stopped)
#     (Table S4)
#     Dependence (no extra digit pattern, heaping on 0 and 5):
#       year_shock : in every year a transient bump of the age distribution
#                    (normal amplitude with sd 3%, random centre, width with
#                    sd 4 years) that is not
#                    carried forward, so it affects several cohorts at once
#       cohort_ar  : cohort-specific deviations that persist over years
#                    (AR(1), rho = 0.7, innovation sd 0.02)
#     Digit patterns (independent sampling, h = 0.01):
#       zero_only, zero_gt_five (ages nearest to 5 move with half the share),
#       two_eight (heaping on ages ending in 2 or 8),
#       time_varying (heaping on 0 and 5, share rising linearly over the
#                     observation years from h/2 to 3h/2)
# ---------------------------------------------------------------------
heap_map <- function(pattern) {                            # target age and weight for each age 10-89
  tg <- rep(NA, length(myers_ages)); wt <- rep(1, length(myers_ages))
  for (i in seq_along(myers_ages)) {
    a <- myers_ages[i]
    cand <- switch(pattern,                                # ages that attract misreports
      zero_only = seq(10, 90, 10),
      two_eight = sort(c(seq(12, 82, 10), seq(18, 88, 10))),
      seq(10, 90, 5))                                      # default: ages ending in 0 or 5
    cand <- cand[cand >= 10 & cand <= 89]
    if (a %in% cand) next                                  # attracting ages keep their persons
    tg[i] <- cand[which.min(abs(cand - a))]                # nearest attracting age (lower on ties)
    if (pattern == "zero_gt_five" && tg[i] %% 10 == 5) wt[i] <- 0.5  # weaker attraction of 5
  }
  list(tg = tg, wt = wt)
}
heap_pattern <- function(x, h, hm) {                       # expected counts after heaping
  new <- x
  for (i in which(!is.na(hm$tg))) {
    k <- h * hm$wt[i] * x[i]                               # persons moving from age i
    new[i] <- new[i] - k; new[hm$tg[i] - 9] <- new[hm$tg[i] - 9] + k
  }
  new
}

