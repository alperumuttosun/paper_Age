# ---------------------------------------------------------------------
# 29. Weak identification by spline flexibility (largest canonical
#     correlation between first differences of the age function and
#     10-periodic sequences, constants removed; 1 = not identified; Table S2)
# ---------------------------------------------------------------------
wid9_file <- file.path(out_dir, "step09_weak_identification_by_df.csv")
if (!file.exists(wid9_file)) {
  ranges <- list(`23-72` = 23:72, `20-79` = 20:79, `25-69` = 25:69, `30-79` = 30:79, `10-89` = 10:89)
  rows <- list()
  for (rn in names(ranges)) for (df in 4:14) {
    a <- ranges[[rn]]
    Bs <- cbind(a, ns(a, df = df))                         # linear term plus natural spline basis
    dB <- Bs[-1, , drop = FALSE] - Bs[-nrow(Bs), , drop = FALSE]  # first differences
    P <- outer(a[-length(a)] %% 10, 0:9, "==") * 1         # 10-periodic sequences
    cen <- function(M) scale(M, scale = FALSE)             # remove constants
    q1 <- qr(cen(dB)); q2 <- qr(cen(P))
    Q1 <- qr.Q(q1)[, seq_len(q1$rank), drop = FALSE]; Q2 <- qr.Q(q2)[, seq_len(q2$rank), drop = FALSE]
    rows[[length(rows) + 1]] <- data.frame(age_range = rn, df = df,
      knot_spacing_years = round(length(a) / df, 1),       # average distance between knots
      max_canonical_correlation = round(max(svd(t(Q1) %*% Q2)$d), 3))
  }
  wid9 <- do.call(rbind, rows)
  write.csv(wid9, wid9_file, row.names = FALSE)
} else wid9 <- read.csv(wid9_file)
print(reshape(wid9[, c("age_range", "df", "max_canonical_correlation")], idvar = "df",
              timevar = "age_range", direction = "wide"), row.names = FALSE)
cat("step09 finished. Files are in:", out_dir, "\n")
